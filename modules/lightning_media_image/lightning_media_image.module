<?php

/**
 * @file
 * Support for image media assets in Lightning.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\lightning_media_image\Hook\LightningMediaImageHooks;
use Drupal\Core\Entity\Display\EntityFormDisplayInterface;
use Drupal\Core\Field\FieldStorageDefinitionInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\image\Entity\ImageStyle;
use Drupal\lightning_core\ConfigHelper as Config;
use Drupal\lightning_core\OverrideHelper as Override;
use Drupal\lightning_media_image\Plugin\media\Source\Image;

/**
 * Implements hook_field_widget_info_alter().
 */
#[LegacyHook]
function lightning_media_image_field_widget_info_alter(array &$info) {
  \Drupal::service(LightningMediaImageHooks::class)->fieldWidgetInfoAlter($info);
}

/**
 * Implements hook_ENTITY_TYPE_insert().
 */
#[LegacyHook]
function lightning_media_image_crop_type_insert($crop_type) {
  \Drupal::service(LightningMediaImageHooks::class)->cropTypeInsert($crop_type);
}

/**
 * Implements hook_modules_installed().
 */
#[LegacyHook]
function lightning_media_image_modules_installed(array $modules) {
  \Drupal::service(LightningMediaImageHooks::class)->modulesInstalled($modules);
}

/**
 * Implements hook_media_source_info_alter().
 */
#[LegacyHook]
function lightning_media_image_media_source_info_alter(array &$sources) {
  \Drupal::service(LightningMediaImageHooks::class)->mediaSourceInfoAlter($sources);
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
#[LegacyHook]
function lightning_media_image_form_entity_browser_image_browser_form_alter(array &$form, FormStateInterface $form_state) {
  \Drupal::service(LightningMediaImageHooks::class)->formEntityBrowserImageBrowserFormAlter($form, $form_state);
}

/**
 * Implements hook_ENTITY_TYPE_presave().
 */
#[LegacyHook]
function lightning_media_image_entity_form_display_presave(EntityFormDisplayInterface $display) {
  return \Drupal::service(LightningMediaImageHooks::class)->entityFormDisplayPresave($display);
}
