<?php

/**
 * @file
 * Adds support for locally-hosted audio files as media items.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\lightning_media_audio\Hook\LightningMediaAudioHooks;

/**
 * Implements hook_media_source_info_alter().
 */
#[LegacyHook]
function lightning_media_audio_media_source_info_alter(array &$sources) {
  \Drupal::service(LightningMediaAudioHooks::class)->mediaSourceInfoAlter($sources);
}
